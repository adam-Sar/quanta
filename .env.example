# Application
APP_NAME=Quanta Data Reliability API
APP_VERSION=0.3.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://quanta:quanta@localhost:5432/quanta
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# File storage (implemented in Task 2)
STORAGE_PATH=./backend/var/storage
MAX_UPLOAD_SIZE_MB=250
UPLOAD_CHUNK_SIZE_BYTES=1048576
CSV_INFER_SCHEMA_LENGTH=10000

# Profiling (implemented in Task 3)
PROFILE_DEFAULT_SAMPLE_ROWS=100000
PROFILE_TOP_VALUES_LIMIT=10
PROFILE_MAX_BYTES_IN_MEMORY=268435456
PROFILE_NULL_THRESHOLD=0.5

# AI provider (planned for Task 7; intentionally unused today)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Distributed jobs (planned; no Redis/Celery dependency in Task 1)
REDIS_URL=

# Local Docker Compose override
POSTGRES_PORT=5432
API_PORT=8000